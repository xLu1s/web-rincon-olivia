---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MapBlock from '../components/MapBlock.astro';
import { bouquets } from '../data/catalog';
import { photos } from '../data/photos';
import { url } from '../lib/paths';
import { buildOrderMessage, whatsappHref } from '../lib/messages';

const hero = bouquets.find((item) => item.slug === 'ciudad-y-campo')!;
const featured = ['ciudad-y-campo', 'silvestre', 'angela', 'hortensia-blanca'].map((slug) => bouquets.find((item) => item.slug === slug)!);
const wa = whatsappHref(buildOrderMessage({ product: 'un ramo de temporada', occasion: '', date: '', dedication: '' }));
const occasions = [
  { name: 'Cumpleaños', photo: '01' as const, alt: hero.copy.es.alt },
  { name: 'Aniversario', photo: '12' as const, alt: 'Ramo de rosas crema y rosa pálido.' },
  { name: 'Nacimiento', photo: '02' as const, alt: 'Ramo silvestre con girasoles y verde.' },
  { name: 'Condolencias', photo: '04' as const, alt: 'Ramo seco y preservado. El servicio de funeral está a confirmar.' },
  { name: 'Para dar las gracias', photo: '10' as const, alt: 'Ramo de hortensia blanca con eucalipto.' },
];
---
<Base
  title="Floristería en Alcoy | Ramos, plantas y flores para bodas | Rincón de Olivia"
  description="Floristería de autor en Alcoy. Ramos de temporada, plantas y decoración floral para bodas y eventos. Encarga por WhatsApp. Recogida en el taller o entrega: la zona está a confirmar."
>
  <section class="hero">
    <div class="hero-copy col">
      <div class="eyebrow">Floristería de autor · Alcoy</div>
      <h1 class="h1">Flores <em>con alma</em>, en el centro de Alcoy.</h1>
      <p class="bl">Ramos a medida, plantas y decoración floral para bodas y eventos.</p>
      <div class="row hero-ctas">
        <a class="btn bwa" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>Pedir por WhatsApp</span></a>
        <a class="btn bsd" href={url('/ramos')}><span>Ver ramos de temporada</span></a>
      </div>
    </div>
    <div class="hero-media">
      <Photo src={photos[hero.photo]} alt={hero.copy.es.alt} widths={[480, 720, 960]} sizes="(min-width: 1280px) 640px, 100vw" quality={40} eager style="object-position:60% center" />
    </div>
  </section>

  <section class="block espuma">
    <div class="head c">
      <div class="filete"></div>
      <div class="eyebrow">Ocasiones</div>
      <h2 class="h2">Para cada <em>ocasión</em>, un ramo</h2>
    </div>
    <div class="occ-grid">
      {occasions.map((item) => (
        <a class="col occ" href={url(`/ramos/?ocasion=${item.name === 'Para dar las gracias' ? 'gracias' : item.name === 'Cumpleaños' ? 'cumpleanos' : item.name === 'Aniversario' ? 'aniversario' : item.name === 'Nacimiento' ? 'nacimiento' : 'condolencias'}`)}>
          <span class="ph-frame r12" style="display:block;overflow:hidden;border-radius:12px">
            <Photo src={photos[item.photo]} alt={item.alt} widths={[320, 480]} sizes="180px" />
          </span>
          <div class="filete" style="width:24px"></div>
          <div class="h4">{item.name}</div>
          <span class="bs">desde a confirmar</span>
        </a>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="ramos-top">
      <div class="head">
        <div class="filete"></div>
        <div class="eyebrow">Ramos de ahora</div>
        <h2 class="h2">Ramos con <em>nombre propio</em></h2>
        <p class="bl">Compuestos en el taller, con flor de temporada.</p>
      </div>
      <a class="btn bsd" href={url('/ramos')}><span>Ver todos los ramos</span><Icon name="arrow" /></a>
    </div>
    <div class="home-grid">
      {featured.map((bouquet) => <ProductCard bouquet={bouquet} />)}
    </div>
  </section>

  <section class="feature">
    <div class="feature-copy papel">
      <div class="head">
        <div class="filete"></div>
        <div class="eyebrow">Bodas y eventos</div>
        <h2 class="h2">Escuchamos vuestra historia y la traducimos <em>en flores</em>.</h2>
      </div>
      <p class="bl">Ramo de novia, mesa y celebración, con la flor de la temporada. Lo que hay publicado: la boda A&amp;A, el ramo Angela y una hortensia blanca.</p>
      <div><a class="btn bp" href={url('/bodas-y-eventos')}><span>Pedir presupuesto de boda</span></a></div>
    </div>
    <div class="feature-photo">
      <Photo src={photos['09']} alt="Mesa de la boda A&A con flores y frutas." widths={[640, 960]} sizes="(min-width: 1280px) 560px, 100vw" />
    </div>
  </section>

  <section class="block founder">
    <div class="ph-frame r16">
      <Photo src={photos['05']} alt="Taller de ramo en grupo. No es un retrato de la fundadora." widths={[640, 900]} sizes="(min-width: 1280px) 480px, 100vw" />
    </div>
    <div class="col" style="gap:24px">
      <div class="head">
        <div class="filete"></div>
        <div class="eyebrow">Quién está detrás</div>
        <h2 class="h2">Una ingeniera agrícola <em>entre flores</em>.</h2>
      </div>
      <p class="bl">La fundadora de Rincón de Olivia es ingeniera técnica agrícola. Trabaja con flor de temporada y te explica cómo cuidar el ramo. El nombre no está publicado.</p>
      <span class="bs err">[Nombre de la fundadora · a confirmar]</span>
    </div>
  </section>

  <section class="block espuma plants">
    <div class="col" style="gap:24px">
      <div class="head">
        <div class="filete"></div>
        <div class="eyebrow">Plantas</div>
        <h2 class="h2">Plantas para casa y <em>para regalar</em></h2>
      </div>
      <p class="bl">En el Día del Padre publicaron plantas y un cítrico a la entrada. La variedad y el precio están a confirmar. Te contamos dónde ponerlas y cada cuánto regarlas.</p>
      <div><a class="btn bsd" href={url('/plantas')}><span>Ver plantas</span><Icon name="arrow" /></a></div>
    </div>
    <div class="ph-frame r16">
      <Photo src={photos['15']} alt="Plantas y un cítrico en la entrada de la floristería." widths={[640, 900]} sizes="(min-width: 1280px) 560px, 100vw" />
    </div>
  </section>

  <section class="block">
    <div class="head c">
      <div class="filete"></div>
      <div class="eyebrow">Cómo pedir</div>
      <h2 class="h2">Tu ramo en <em>tres pasos</em></h2>
    </div>
    <div class="steps">
      <div class="col step" style="gap:8px"><div class="n">01</div><div class="h4">Elige tu ramo</div><p class="bm">Mira los ramos de temporada o cuéntanos qué tienes en mente.</p></div>
      <div class="col step" style="gap:8px"><div class="n">02</div><div class="h4">Escríbenos por WhatsApp</div><p class="bm">Te llega el mensaje ya preparado con el ramo, la ocasión, la fecha y la dedicatoria. También puedes llamar.</p></div>
      <div class="col step" style="gap:8px"><div class="n">03</div><div class="h4">Recógelo o te lo llevamos</div><p class="bm">En el taller o a domicilio en Alcoy. La zona y el porte están a confirmar. Pagas al confirmar el encargo.</p></div>
    </div>
  </section>

  <section class="block papel">
    <div class="ramos-top">
      <div class="head">
        <div class="filete"></div>
        <div class="eyebrow">Opiniones</div>
        <h2 class="h2">Lo que dicen de <em>nuestros ramos</em></h2>
      </div>
      <p class="bm" style="max-width:360px">Reseñas de ejemplo: se sustituirán por reseñas reales de Google. No hay nota oficial verificada.</p>
    </div>
    <div class="rev-grid">
      {Array.from({ length: 3 }).map(() => (
        <div class="rev">
          <q>Texto de reseña de ejemplo: aquí irá una opinión real de Google sobre un ramo o una boda.</q>
          <div style="width:32px;height:1px;background:#C4A484"></div>
          <b style="font:500 16px Outfit">Nombre de clienta</b>
          <span class="bs" style="font-size:13px">Reseña de ejemplo · sustituir por reseñas reales</span>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <div class="papel visit-inner">
      <MapBlock height="640px" />
      <ContactBlock />
    </div>
  </section>
</Base>
