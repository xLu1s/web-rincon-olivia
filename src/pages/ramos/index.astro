---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import BouquetFilters from '../../components/islands/BouquetFilters';
import { bouquets } from '../../data/catalog';
import { getUi } from '../../i18n/ui';
import { breadcrumbJsonLd } from '../../lib/schema';
import { buildOrderMessage, whatsappHref } from '../../lib/messages';
import { sameDayCutoff } from '../../data/site';

const ui = getUi();
const custom = whatsappHref(buildOrderMessage({
  product: 'un ramo a medida',
  occasion: '',
  date: '',
  dedication: '',
}));
const labels = {
  occasion: ui.filters.occasion,
  type: ui.filters.type,
  delivery: ui.filters.delivery,
  allOccasions: ui.filters.allOccasions,
  allTypes: ui.filters.allTypes,
  today: ui.filters.today,
  color: 'Color',
  allColors: 'Todos',
  rosa: 'Rosa y blush',
  crema: 'Crema',
  amarillo: 'Amarillo',
  mixto: 'Mixto',
  fresco: ui.filters.fresco,
  novia: ui.filters.novia,
  seco: ui.filters.seco,
  cumpleanos: ui.filters.cumpleanos,
  aniversario: ui.filters.aniversario,
  nacimiento: ui.filters.nacimiento,
  condolencias: ui.filters.condolencias,
  gracias: ui.filters.gracias,
  emptyNone: ui.empty.none,
  emptyCondolencias: ui.empty.condolencias,
  emptyToday: ui.empty.today,
};
---
<Base
  current="ramos"
  title="Ramos de flores en Alcoy | Temporada y a medida | Rincón de Olivia"
  description="Ramos compuestos en el taller de Alcoy, con flor de temporada. Para cumpleaños, aniversario, nacimiento y más. Pide por WhatsApp. El precio «desde» está a confirmar."
  jsonLd={[breadcrumbJsonLd([{ name: 'Inicio', path: '/' }, { name: 'Ramos', path: '/ramos' }])]}
>
  <div class="block tight">
    <div class="head">
      <div class="eyebrow">Ramos</div>
      <h1 class="h1">Ramos de <em>temporada</em></h1>
      <p class="bl" style="max-width:640px">Compuestos en el taller, con flor de temporada. Precios «desde a confirmar»; te confirmamos el final por WhatsApp.</p>
      <p class="bs">Hora límite para encargos de hoy: {sameDayCutoff.label}.</p>
    </div>
  </div>
  <div class="catalog">
    <div class="col" style="gap:28px">
      <BouquetFilters client:visible labels={labels} />
      <div class="col blushbg r16" style="padding:24px;gap:12px">
        <div class="h4">¿Uno a medida?</div>
        <p class="bm ink">Cuéntanos ocasión, colores y para cuándo.</p>
        <a class="btn bwa full sm" href={custom} target="_blank" rel="noopener noreferrer"><span>WhatsApp</span></a>
      </div>
    </div>
    <div class="col" style="gap:20px">
      <p class="bm" data-bouquet-count>{bouquets.length} ramos</p>
      <p class="bm" data-bouquet-empty hidden>{ui.empty.none}</p>
      <div class="ramos-grid">
        {bouquets.map((bouquet) => <ProductCard bouquet={bouquet} />)}
      </div>
    </div>
  </div>
</Base>
