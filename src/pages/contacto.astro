---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MapBlock from '../components/MapBlock.astro';
import { address, siteConfig } from '../data/site';
import { url } from '../lib/paths';
import { breadcrumbJsonLd } from '../lib/schema';
import { buildOrderMessage, whatsappHref } from '../lib/messages';
const wa = whatsappHref(buildOrderMessage({ product: 'un ramo de temporada', occasion: '', date: '', dedication: '' }));
---
<Base
  current="contacto"
  title="Contacto | Floristería en Alcoy | Rincón de Olivia"
  description="WhatsApp y teléfono 628 48 41 02. Floristería en Alcoy: la dirección y el horario están a confirmar. La forma más rápida es WhatsApp."
  jsonLd={[breadcrumbJsonLd([{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto' }])]}
>
  <div class="block" style="padding-bottom:48px">
    <div class="head c">
      <div class="filete"></div>
      <div class="eyebrow">Contacto</div>
      <h1 class="h1"><em>Hablemos</em></h1>
      <p class="bl">La forma más rápida es WhatsApp. También puedes llamar o pasar por el taller.</p>
    </div>
  </div>
  <div style="padding:0 20px 40px">
    <div class="contact-cards">
      <div class="col espuma r16" style="padding:32px;gap:12px;border:1px solid #C4A484">
        <div class="pin" style="width:48px;height:48px;border-radius:50%;background:#E8C4B8;display:flex;align-items:center;justify-content:center"><Icon name="wa" /></div>
        <div class="h4">WhatsApp</div>
        <p class="bm">{siteConfig.phoneDisplay} · número pendiente de confirmar</p>
        <a class="btn bwa full" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>Escribir</span></a>
      </div>
      <div class="col espuma r16" style="padding:32px;gap:12px;border:1px solid #C4A484">
        <div class="pin" style="width:48px;height:48px;border-radius:50%;background:#E8C4B8;display:flex;align-items:center;justify-content:center"><Icon name="tel" /></div>
        <div class="h4">Llamada</div>
        <p class="bm">{siteConfig.phoneDisplay}</p>
        <a class="btn bcall full" href={`tel:${siteConfig.phoneE164}`}><Icon name="tel" /><span>Llamar</span></a>
      </div>
      <div class="col espuma r16" style="padding:32px;gap:12px;border:1px solid #C4A484">
        <div class="pin" style="width:48px;height:48px;border-radius:50%;background:#E8C4B8;display:flex;align-items:center;justify-content:center"><Icon name="pin" /></div>
        <div class="h4">Visítanos</div>
        <p class="bm">{address.street}, {address.postalCode} {address.locality}</p>
        <div class="badge bc">A confirmar</div>
      </div>
    </div>
  </div>
  <div class="block papel">
    <div class="visit-inner">
      <MapBlock height="600px" />
      <ContactBlock />
    </div>
  </div>
</Base>
