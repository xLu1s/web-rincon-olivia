---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { photos } from '../data/photos';
import { url } from '../lib/paths';
import type { Bouquet } from '../data/catalog';
interface Props { bouquet: Bouquet; }
const { bouquet } = Astro.props;
const copy = bouquet.copy.es;
---
<a
  class="card cd"
  href={url(`/ramos/${bouquet.slug}`)}
  data-bouquet
  data-slug={bouquet.slug}
  data-type={bouquet.type}
  data-color={bouquet.color}
  data-occasions={bouquet.occasions.join(',')}
  data-same-day={bouquet.sameDay ? 'true' : 'false'}
>
  <div class="im">
    <Photo src={photos[bouquet.photo]} alt={copy.alt} widths={[360, 640, 800]} sizes="(min-width: 1280px) 280px, 46vw" />
    <div class="badge bt"><Icon name="leaf" size={14} />Temporada</div>
  </div>
  <div class="in">
    <div class="nm">{copy.name}</div>
    <div class="ds">{copy.summary}</div>
    <div class="pr"><span>desde a confirmar</span><Icon name="arrow" /></div>
  </div>
</a>
