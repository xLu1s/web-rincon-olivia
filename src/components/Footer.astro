---
import Icon from './Icon.astro';
import { address, siteConfig } from '../data/site';
import { url } from '../lib/paths';
const year = 2026;
---
<footer class="foot">
  <a class="wm c" href={url('/')}>
    <b>{siteConfig.name}</b>
    <small>{siteConfig.tagline}</small>
  </a>
  <p class="bs">Sustituir por logo real</p>
  <div class="line"></div>
  <div class="foot-cols col" style="gap:16px;align-self:stretch">
    <div class="col" style="gap:10px">
      <div class="h4">Contacto</div>
      <p class="bm">{address.street}, {address.postalCode} {address.locality} (a confirmar)</p>
      <p class="bm">{siteConfig.phoneDisplay} · llamada y WhatsApp</p>
      <p class="bm">Horario: pendiente de confirmar</p>
    </div>
    <div class="col" style="gap:10px">
      <div class="h4">Floristería</div>
      <div class="links">
        <a href={url('/ramos')}>Ramos</a>
        <a href={url('/plantas')}>Plantas</a>
        <a href={url('/bodas-y-eventos')}>Bodas y eventos</a>
        <a href={url('/talleres')}>Talleres</a>
        <a href={url('/encargos-y-entrega')}>Encargos y entrega</a>
      </div>
    </div>
    <div class="col" style="gap:10px">
      <div class="h4">Rincón</div>
      <div class="links">
        <a href={url('/la-floristeria')}>La floristería</a>
        <a href={url('/contacto')}>Contacto</a>
        <a href={url('/aviso-legal')}>Aviso legal</a>
        <a href={url('/privacidad')}>Privacidad</a>
        <a href={url('/cookies')}>Cookies</a>
      </div>
    </div>
    <div class="col" style="gap:10px">
      <div class="h4">Síguenos</div>
      <a class="row" style="gap:8px" href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="ig" /><span class="bm">{siteConfig.instagramHandle}</span>
      </a>
    </div>
  </div>
  <div class="line"></div>
  <div class="row" style="justify-content:space-between;align-self:stretch;flex-wrap:wrap">
    <p class="bs">© {year} {siteConfig.name} · Floristería en Alcoy</p>
    <p class="bs">Propuesta web de Luis Balaguer</p>
  </div>
</footer>
