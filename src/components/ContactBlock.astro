---
import Icon from './Icon.astro';
import { address, hours, siteConfig } from '../data/site';
import { buildOrderMessage, whatsappHref } from '../lib/messages';
const wa = whatsappHref(buildOrderMessage({ product: 'un ramo de temporada', occasion: '', date: '', dedication: '' }));
---
<div class="col espuma r16" style="padding:32px 24px;gap:20px">
  <div class="filete"></div>
  <div class="h3">Visítanos</div>
  <div class="cinfo"><Icon name="pin" /><div class="col" style="gap:4px"><span class="k">Dirección</span><span class="v">{address.street}, {address.postalCode} {address.locality}</span><div class="badge bc">A confirmar</div><span class="bs">{address.alternativeNote}</span></div></div>
  <div class="cinfo"><Icon name="tel" /><div class="col" style="gap:2px"><span class="k">Teléfono</span><a class="v" href={`tel:${siteConfig.phoneE164}`}>{siteConfig.phoneDisplay}</a></div></div>
  <div class="cinfo"><Icon name="wa" /><div class="col" style="gap:2px"><span class="k">WhatsApp</span><span class="v">{siteConfig.phoneDisplay}</span><span class="bs err" style="font-size:13px">Mismo número · pendiente de confirmar</span></div></div>
  <div class="note">
    <div class="row" style="gap:8px"><Icon name="clock" /><span class="eyebrow ink">Horario</span></div>
    <p class="bs err" style="font-size:13px">{hours.note}</p>
    <p class="bm">{hours.rows.map((row) => `${row.days} · ${row.value}`).join(' · ')}</p>
  </div>
  <div class="cinfo"><Icon name="ig" /><div class="col" style="gap:2px"><span class="k">Instagram</span><a class="v" href={siteConfig.instagram} target="_blank" rel="noopener noreferrer">{siteConfig.instagramHandle}</a></div></div>
  <div class="col" style="gap:12px">
    <a class="btn bwa full" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>Pedir por WhatsApp</span></a>
    <a class="btn bcall full" href={`tel:${siteConfig.phoneE164}`}><Icon name="tel" /><span>Llamar</span></a>
  </div>
</div>
