---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, widths, sizes, eager = false, class: className } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  quality={eager ? 68 : 62}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  class={className}
  pictureAttributes={{ class: 'photo' }}
/>
