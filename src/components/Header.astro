---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { url } from '../lib/paths';
import { buildOrderMessage, whatsappHref } from '../lib/messages';

interface Props { current?: string; }
const { current = '' } = Astro.props;
const wa = whatsappHref(buildOrderMessage({ product: 'un ramo de temporada', occasion: '', date: '', dedication: '' }));
const left = [
  { id: 'ramos', href: url('/ramos'), label: 'Ramos' },
  { id: 'plantas', href: url('/plantas'), label: 'Plantas' },
  { id: 'bodas', href: url('/bodas-y-eventos'), label: 'Bodas y eventos' },
  { id: 'encargos', href: url('/encargos-y-entrega'), label: 'Encargos' },
];
const right = [
  { id: 'floristeria', href: url('/la-floristeria'), label: 'La floristería' },
  { id: 'contacto', href: url('/contacto'), label: 'Contacto' },
];
const all = [
  ...left,
  { id: 'talleres', href: url('/talleres'), label: 'Talleres' },
  ...right,
];
---
<header class="site-header">
  <div class="hdr">
    <a class="wm" href={url('/')}>
      <b>{siteConfig.name}</b>
      <small>{siteConfig.tagline}</small>
    </a>
    <div class="row" style="gap:8px">
      <a class="btn bwa sm wa-tab" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>WhatsApp</span></a>
      <details class="menu">
        <summary class="hit" aria-label="Abrir el menú"><Icon name="menu" /></summary>
        <div class="menu-panel">
          {all.map((link) => (
            <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
  <div class="hdrd">
    <nav class="nav" aria-label="Principal">
      {left.map((link) => (
        <a class={current === link.id ? 'on' : ''} href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="wm c" href={url('/')}>
      <b>{siteConfig.name}</b>
      <small>{siteConfig.tagline}</small>
    </a>
    <div class="nav r">
      {right.map((link) => (
        <a class={current === link.id ? 'on' : ''} href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
      ))}
      <span><b style="color:#2C241C">ES</b> · <span style="opacity:.6" title="Valenciano, próximamente">VA</span></span>
      <a class="btn bwa sm" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>Pedir por WhatsApp</span></a>
    </div>
  </div>
</header>
