---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
import { buildOrderMessage, whatsappHref } from '../lib/messages';
const wa = whatsappHref(buildOrderMessage({ product: 'un ramo de temporada', occasion: '', date: '', dedication: '' }));
---
<nav class="sticky" aria-label="Acciones rápidas">
  <a class="btn bwa" href={wa} target="_blank" rel="noopener noreferrer"><Icon name="wa" /><span>Pedir por WhatsApp</span></a>
  <a class="btn bcall" href={`tel:${siteConfig.phoneE164}`} aria-label="Llamar"><Icon name="tel" /></a>
</nav>
